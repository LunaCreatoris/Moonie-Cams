# Copy to .env (git-ignored). Read by `just up` / `just down` / `just logs`.

# Host network interface the camera copies sit on (macvlan parent), e.g. eth0 or ens18
CAMS_PARENT=CHANGE_ME
# The LAN that interface is on, and its gateway
CAMS_SUBNET=CHANGE_ME
CAMS_GATEWAY=CHANGE_ME
# Time zone of the go2rtc containers (logs, ONVIF clock)
TZ=Etc/UTC
# Compose project (default moonie-cams). Give each stack on one host its own, e.g. one per camera VLAN:
# lowercase letters, digits, - and _. Read by `just render` too.
#COMPOSE_PROJECT_NAME=moonie-cams

# Webhook support (README "Webhook support"): every camera state change is POSTed as JSON here.
# Empty: off. Read by `just render` too: a URL needs CAMS_WEBHOOK_NETWORK.
CAMS_WEBHOOK_URL=
# The external Docker network the endpoint is reachable on (e.g. the network n8n is on)
CAMS_WEBHOOK_NETWORK=
# true: also post the first state seen of each camera (default false: only changes are posted)
CAMS_WEBHOOK_ON_START=false
