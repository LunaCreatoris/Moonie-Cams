+// Advertised video profile: the live stream's size and frame rate when LiveVideo finds
+// them, else the ONVIF_* environment variables (positive integers), else go2rtc's
+// defaults. The bitrate (kbit/s) has no live source.
+var (
+	envWidth   = envInt("ONVIF_WIDTH", 1920)
+	envHeight  = envInt("ONVIF_HEIGHT", 1080)
+	envFPS     = envInt("ONVIF_FPS", 30)
+	envBitrate = envInt("ONVIF_BITRATE", 8192)
+)
+
+// LiveVideo returns a stream's size and frame rate from its running producer; 0 is unknown.
+var LiveVideo func(name string) (width, height, fps int)
+
+func envInt(key string, def int) int {
+	if v, err := strconv.Atoi(os.Getenv(key)); err == nil && v > 0 {
+		return v
+	}
+	return def
+}
+
+func profile(name string) (width, height, fps, bitrate int) {
+	width, height, fps, bitrate = envWidth, envHeight, envFPS, envBitrate
+	if name == "" || LiveVideo == nil {
+		return
+	}
+	w, h, f := LiveVideo(name)
+	if w > 0 && h > 0 {
+		width, height = w, h
+	}
+	if f > 0 && f <= 240 {
+		fps = f
+	}
+	return
+}
