+package onvif
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+const rebootRequest = `<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope"><s:Body>` +
+	`<tds:SystemReboot xmlns:tds="http://www.onvif.org/ver10/device/wsdl"/></s:Body></s:Envelope>`
+
+func TestSystemRebootIsRefused(t *testing.T) {
+	for i := 0; i < 3; i++ {
+		w := httptest.NewRecorder()
+		onvifDeviceService(w, httptest.NewRequest("POST", "/onvif/device_service", strings.NewReader(rebootRequest)))
+		require.Equal(t, http.StatusInternalServerError, w.Code)
+		body := w.Body.String()
+		require.Contains(t, body, "<s:Fault ")
+		require.Contains(t, body, "ter:ActionNotSupported")
+		require.NotContains(t, body, "SystemRebootResponse")
+	}
+	// Upstream exits one second after a reboot request; a test binary that exits fails the run
+	time.Sleep(1500 * time.Millisecond)
+}
