+// LiveMedias returns the medias of the config producers already running; it never starts
+// one. A producer a client pushed (stateExternal) does not count, and one that is busy
+// (Dial holds its lock while the camera answers) is skipped rather than waited for.
+func (s *Stream) LiveMedias() (medias []*core.Media) {
+	s.mu.Lock()
+	producers := append([]*Producer(nil), s.producers...)
+	s.mu.Unlock()
+
+	for _, prod := range producers {
+		if !prod.mu.TryLock() {
+			continue
+		}
+		if prod.state == stateStart && prod.conn != nil {
+			medias = append(medias, prod.conn.GetMedias()...)
+		}
+		prod.mu.Unlock()
+	}
+	return
+}
