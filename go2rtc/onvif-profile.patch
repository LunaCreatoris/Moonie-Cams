+package streams
+
+import (
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLiveMediasCountsRunningProducersOnly(t *testing.T) {
+	running := &core.Media{Kind: core.KindVideo, ID: "running"}
+	stream := NewStream(nil)
+	stream.producers = []*Producer{
+		{conn: &healthFake{core.Connection{Medias: []*core.Media{running}}}, state: stateStart},
+		{conn: &healthFake{core.Connection{Medias: []*core.Media{{ID: "pushed"}}}}, state: stateExternal},
+		{conn: &healthFake{core.Connection{Medias: []*core.Media{{ID: "dialed"}}}}, state: stateMedias},
+		{state: stateStart},
+	}
+	require.Equal(t, []*core.Media{running}, stream.LiveMedias())
+}
+
+func TestLiveMediasDoesNotWaitForADial(t *testing.T) {
+	running := &core.Media{Kind: core.KindVideo, ID: "running"}
+	dialing := &Producer{state: stateNone}
+	stream := NewStream(nil)
+	stream.producers = []*Producer{
+		dialing,
+		{conn: &healthFake{core.Connection{Medias: []*core.Media{running}}}, state: stateStart},
+	}
+	// Dial holds the producer's lock for as long as the camera takes to answer
+	dialing.mu.Lock()
+	defer dialing.mu.Unlock()
+
+	done := make(chan []*core.Media, 1)
+	go func() { done <- stream.LiveMedias() }()
+	select {
+	case medias := <-done:
+		require.Equal(t, []*core.Media{running}, medias)
+	case <-time.After(2 * time.Second):
+		t.Fatal("LiveMedias waits for a producer that is dialing")
+	}
+
+	// The stream's own lock is free while a producer is dialing
+	require.True(t, stream.mu.TryLock())
+	stream.mu.Unlock()
+}
