diff --git a/pkg/h264/sps_crafted_test.go b/pkg/h264/sps_crafted_test.go
new file mode 100644
index 0000000..c50d88d
--- /dev/null
+++ b/pkg/h264/sps_crafted_test.go
@@ -0,0 +1,147 @@
+package h264
+
+import (
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/bits"
+	"github.com/stretchr/testify/require"
+)
+
+// craftedSPS describes a Baseline SPS built bit by bit, to reach values no encoder writes.
+type craftedSPS struct {
+	pocType, pocCycle  uint32
+	widthMbs, heightMb uint32 // in macroblocks, both at least 1
+	cropLeft, cropTop  uint32
+	tick, timeScale    uint32 // VUI timing; no timing info when both are 0
+}
+
+// writeUE writes v as unsigned Exp-Golomb, the way bits.Reader.ReadUEGolomb reads it back.
+func writeUE(w *bits.Writer, v uint32) {
+	x := uint64(v) + 1
+	size := byte(0)
+	for x>>(size+1) != 0 {
+		size++
+	}
+	w.WriteAllBits(0, size)
+	w.WriteBit(1)
+	w.WriteBits(uint32(x), size)
+}
+
+func (c craftedSPS) bytes() []byte {
+	w := bits.NewWriter(nil)
+	w.WriteBits8(0x67, 8) // NAL header: SPS
+	w.WriteBits8(66, 8)   // profile_idc: Baseline
+	w.WriteBits8(0, 8)    // constraint flags
+	w.WriteBits8(30, 8)   // level_idc
+	writeUE(w, 0)         // seq_parameter_set_id
+	writeUE(w, 0)         // log2_max_frame_num_minus4
+	writeUE(w, c.pocType)
+	switch c.pocType {
+	case 0:
+		writeUE(w, 0) // log2_max_pic_order_cnt_lsb_minus4
+	case 1:
+		w.WriteBit(0) // delta_pic_order_always_zero_flag
+		writeUE(w, 0) // offset_for_non_ref_pic
+		writeUE(w, 0) // offset_for_top_to_bottom_field
+		writeUE(w, c.pocCycle)
+		if c.pocCycle <= 256 {
+			for i := uint32(0); i < c.pocCycle; i++ {
+				writeUE(w, 0) // offset_for_ref_frame[i]
+			}
+		}
+	}
+	writeUE(w, 1) // num_ref_frames
+	w.WriteBit(0) // gaps_in_frame_num_value_allowed_flag
+	writeUE(w, c.widthMbs-1)
+	writeUE(w, c.heightMb-1)
+	w.WriteBit(1) // frame_mbs_only_flag
+	w.WriteBit(1) // direct_8x8_inference_flag
+	if c.cropLeft != 0 || c.cropTop != 0 {
+		w.WriteBit(1)
+		writeUE(w, c.cropLeft)
+		writeUE(w, 0)
+		writeUE(w, c.cropTop)
+		writeUE(w, 0)
+	} else {
+		w.WriteBit(0)
+	}
+	w.WriteBit(1) // vui_parameters_present_flag
+	w.WriteBit(0) // aspect_ratio_info_present_flag
+	w.WriteBit(0) // overscan_info_present_flag
+	w.WriteBit(0) // video_signal_type_present_flag
+	w.WriteBit(0) // chroma_loc_info_present_flag
+	if c.tick != 0 || c.timeScale != 0 {
+		w.WriteBit(1)
+		w.WriteBits(c.tick, 32)
+		w.WriteBits(c.timeScale, 32)
+		w.WriteBit(1) // fixed_frame_rate_flag
+	} else {
+		w.WriteBit(0)
+	}
+	w.WriteBit(1) // rbsp_stop_one_bit
+	return append(w.Bytes(), 0, 0)
+}
+
+func TestCraftedSPS(t *testing.T) {
+	s := DecodeSPS(craftedSPS{widthMbs: 40, heightMb: 30, tick: 1, timeScale: 50}.bytes())
+	require.NotNil(t, s)
+	require.Equal(t, uint16(640), s.Width())
+	require.Equal(t, uint16(480), s.Height())
+	width, height := s.Size()
+	require.Equal(t, [2]int{640, 480}, [2]int{width, height})
+	require.Equal(t, 25, s.FPS())
+}
+
+func TestSPSFPSDoesNotWrap(t *testing.T) {
+	// 2 * num_units_in_tick is 2^32: it wraps to 0 in uint32, a division by zero
+	s := DecodeSPS(craftedSPS{widthMbs: 1, heightMb: 1, tick: 1 << 31, timeScale: 0xFFFFFFFF}.bytes())
+	require.NotNil(t, s)
+	require.Equal(t, 1, s.FPS())
+
+	s = DecodeSPS(craftedSPS{widthMbs: 1, heightMb: 1, tick: 0xFFFFFFFF, timeScale: 1}.bytes())
+	require.NotNil(t, s)
+	require.Equal(t, 0, s.FPS())
+
+	s = DecodeSPS(craftedSPS{widthMbs: 1, heightMb: 1}.bytes())
+	require.NotNil(t, s)
+	require.Equal(t, 0, s.FPS())
+}
+
+func TestSPSHugePicOrderCycle(t *testing.T) {
+	decode := func(c craftedSPS) *SPS {
+		done := make(chan *SPS, 1)
+		go func() { done <- DecodeSPS(c.bytes()) }()
+		select {
+		case s := <-done:
+			return s
+		case <-time.After(2 * time.Second):
+			t.Fatalf("DecodeSPS loops on num_ref_frames_in_pic_order_cnt_cycle=%d", c.pocCycle)
+			return nil
+		}
+	}
+
+	require.NotNil(t, decode(craftedSPS{pocType: 1, pocCycle: 255, widthMbs: 1, heightMb: 1}))
+	require.Nil(t, decode(craftedSPS{pocType: 1, pocCycle: 256, widthMbs: 1, heightMb: 1}))
+	require.Nil(t, decode(craftedSPS{pocType: 1, pocCycle: 0xFFFFFFFE, widthMbs: 1, heightMb: 1}))
+}
+
+func TestSPSSizeOutOfRange(t *testing.T) {
+	for name, c := range map[string]craftedSPS{
+		"width underflow":  {widthMbs: 1, heightMb: 1, cropLeft: 100},
+		"height underflow": {widthMbs: 1, heightMb: 1, cropTop: 8},
+		"crop wraps":       {widthMbs: 1, heightMb: 1, cropLeft: 0x80000000},
+		"too wide":         {widthMbs: 513, heightMb: 1},
+		"too high":         {widthMbs: 1, heightMb: 513},
+		"huge":             {widthMbs: 0xFFFFFFFF, heightMb: 1},
+	} {
+		s := DecodeSPS(c.bytes())
+		require.NotNil(t, s, name)
+		width, height := s.Size()
+		require.Equal(t, [2]int{0, 0}, [2]int{width, height}, name)
+	}
+
+	s := DecodeSPS(craftedSPS{widthMbs: 512, heightMb: 512}.bytes())
+	width, height := s.Size()
+	require.Equal(t, [2]int{8192, 8192}, [2]int{width, height})
+}
