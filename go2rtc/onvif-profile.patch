+// maxSide is the largest width or height Size accepts, H.264's own limit (level 6.2).
+const maxSide = 8192
+
+// Size returns the picture size, or 0, 0 when it is outside 1..maxSide on either side. It
+// computes in int64, so crop offsets larger than the picture cannot wrap around the way
+// they do in Width and Height.
+func (s *SPS) Size() (width, height int) {
+	w := 16 * (int64(s.pic_width_in_mbs_minus_1) + 1)
+	h := 16 * (int64(s.pic_height_in_map_units_minus_1) + 1)
+	if s.frame_mbs_only_flag == 0 {
+		h *= 2
+	}
+	w -= 2 * (int64(s.frame_crop_left_offset) + int64(s.frame_crop_right_offset))
+	h -= 2 * (int64(s.frame_crop_top_offset) + int64(s.frame_crop_bottom_offset))
+	if w < 1 || w > maxSide || h < 1 || h > maxSide {
+		return 0, 0
+	}
+	return int(w), int(h)
+}
+
+// FPS returns the frame rate from the VUI timing info, or 0 when the SPS has none. It
+// computes in uint64: 2 * num_units_in_tick wraps to 0 in uint32 when the tick is 2^31.
+func (s *SPS) FPS() int {
+	if s.timing_info_present_flag == 0 || s.num_units_in_tick == 0 {
+		return 0
+	}
+	tick, scale := uint64(s.num_units_in_tick), uint64(s.time_scale)
+	// One frame is two ticks (fields), rounded to the nearest integer
+	return int((scale + tick) / (2 * tick))
+}
