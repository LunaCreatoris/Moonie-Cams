+	"net/url"
 	"os"
 	"regexp"
 	"strconv"
+	"strings"
 	"time"
 )
 
+// Identity is what the ONVIF server announces in GetDeviceInformation and GetScopes.
+// An empty Location drops the location scope.
+type Identity struct {
+	Name, Manufacturer, Model, Location string
+}
+
+// DeviceIdentity comes from ONVIF_NAME, ONVIF_MANUFACTURER, ONVIF_MODEL and ONVIF_LOCATION.
+var DeviceIdentity = IdentityFromEnv(os.LookupEnv)
+
+// IdentityFromEnv reads the identity; an unset or empty value keeps upstream's, except
+// ONVIF_LOCATION, which set to "" drops the location scope.
+func IdentityFromEnv(lookup func(string) (string, bool)) Identity {
+	id := Identity{Name: "go2rtc", Manufacturer: "", Model: "go2rtc", Location: "github"}
+	for key, field := range map[string]*string{"ONVIF_NAME": &id.Name, "ONVIF_MANUFACTURER": &id.Manufacturer, "ONVIF_MODEL": &id.Model} {
+		if v, ok := lookup(key); ok && v != "" {
+			*field = v
+		}
+	}
+	if v, ok := lookup("ONVIF_LOCATION"); ok {
+		id.Location = v
+	}
+	return id
+}
+
+// xmlText escapes s for XML text; characters XML cannot hold become U+FFFD.
+func xmlText(s string) string {
+	var b strings.Builder
+	_ = xml.EscapeText(&b, []byte(s))
+	return b.String()
+}
+
+// GetScopesResponse lists the fixed scopes, the name and location URL-escaped.
+func GetScopesResponse(id Identity) []byte {
+	items := []string{"onvif://www.onvif.org/name/" + url.PathEscape(id.Name)}
+	if id.Location != "" {
+		items = append(items, "onvif://www.onvif.org/location/"+url.PathEscape(id.Location))
+	}
+	items = append(items, "onvif://www.onvif.org/Profile/Streaming", "onvif://www.onvif.org/type/Network_Video_Transmitter")
+	e := NewEnvelope()
+	e.Append("<tds:GetScopesResponse>\n")
+	for _, item := range items {
+		e.Appendf("\t<tds:Scopes><tt:ScopeDef>Fixed</tt:ScopeDef><tt:ScopeItem>%s</tt:ScopeItem></tds:Scopes>\n", xmlText(item))
+	}
+	e.Append("</tds:GetScopesResponse>")
+	return e.Bytes()
+}
+
