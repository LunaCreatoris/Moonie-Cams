diff --git a/pkg/onvif/identity_test.go b/pkg/onvif/identity_test.go
new file mode 100644
index 0000000..ca8d11c
--- /dev/null
+++ b/pkg/onvif/identity_test.go
@@ -0,0 +1,110 @@
+package onvif
+
+import (
+	"encoding/xml"
+	"net/url"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// upstreamScopes is go2rtc v1.9.15's fixed GetScopes answer, which the defaults must keep.
+const upstreamScopes = `<tds:GetScopesResponse>
+	<tds:Scopes><tt:ScopeDef>Fixed</tt:ScopeDef><tt:ScopeItem>onvif://www.onvif.org/name/go2rtc</tt:ScopeItem></tds:Scopes>
+	<tds:Scopes><tt:ScopeDef>Fixed</tt:ScopeDef><tt:ScopeItem>onvif://www.onvif.org/location/github</tt:ScopeItem></tds:Scopes>
+	<tds:Scopes><tt:ScopeDef>Fixed</tt:ScopeDef><tt:ScopeItem>onvif://www.onvif.org/Profile/Streaming</tt:ScopeItem></tds:Scopes>
+	<tds:Scopes><tt:ScopeDef>Fixed</tt:ScopeDef><tt:ScopeItem>onvif://www.onvif.org/type/Network_Video_Transmitter</tt:ScopeItem></tds:Scopes>
+</tds:GetScopesResponse>`
+
+func env(values map[string]string) func(string) (string, bool) {
+	return func(key string) (string, bool) {
+		v, ok := values[key]
+		return v, ok
+	}
+}
+
+// scopeItems parses a GetScopes answer and returns its ScopeItem values, unescaped from XML.
+func scopeItems(t *testing.T, b []byte) []string {
+	var doc struct {
+		Items []string `xml:"Body>GetScopesResponse>Scopes>ScopeItem"`
+	}
+	require.NoError(t, xml.Unmarshal(b, &doc))
+	return doc.Items
+}
+
+type deviceInformation struct {
+	Manufacturer, Model, FirmwareVersion, SerialNumber string
+}
+
+func parseDeviceInformation(t *testing.T, b []byte) deviceInformation {
+	var doc struct {
+		Info deviceInformation `xml:"Body>GetDeviceInformationResponse"`
+	}
+	require.NoError(t, xml.Unmarshal(b, &doc))
+	return doc.Info
+}
+
+func TestIdentityDefaultsAreUpstreams(t *testing.T) {
+	id := IdentityFromEnv(env(nil))
+	require.Equal(t, Identity{Name: "go2rtc", Manufacturer: "", Model: "go2rtc", Location: "github"}, id)
+
+	want := NewEnvelope()
+	want.Append(upstreamScopes)
+	require.Equal(t, string(want.Bytes()), string(GetScopesResponse(id)))
+	// Empty values are not an identity: upstream's stays
+	empty := map[string]string{"ONVIF_NAME": "", "ONVIF_MANUFACTURER": "", "ONVIF_MODEL": ""}
+	require.Equal(t, id, IdentityFromEnv(env(empty)))
+}
+
+func TestIdentityFromEnv(t *testing.T) {
+	id := IdentityFromEnv(env(map[string]string{
+		"ONVIF_NAME":         "Front",
+		"ONVIF_MANUFACTURER": "Moonie-Cams",
+		"ONVIF_MODEL":        "Cams",
+		"ONVIF_LOCATION":     "Porch",
+	}))
+	require.Equal(t, Identity{Name: "Front", Manufacturer: "Moonie-Cams", Model: "Cams", Location: "Porch"}, id)
+	require.Equal(t, []string{
+		"onvif://www.onvif.org/name/Front",
+		"onvif://www.onvif.org/location/Porch",
+		"onvif://www.onvif.org/Profile/Streaming",
+		"onvif://www.onvif.org/type/Network_Video_Transmitter",
+	}, scopeItems(t, GetScopesResponse(id)))
+
+	info := parseDeviceInformation(t, GetDeviceInformationResponse(id.Manufacturer, id.Model, "1.9.15", "192.0.2.10"))
+	require.Equal(t, deviceInformation{"Moonie-Cams", "Cams", "1.9.15", "192.0.2.10"}, info)
+}
+
+func TestEmptyLocationDropsTheScope(t *testing.T) {
+	id := IdentityFromEnv(env(map[string]string{"ONVIF_NAME": "Front", "ONVIF_LOCATION": ""}))
+	require.Equal(t, "", id.Location)
+	require.Equal(t, []string{
+		"onvif://www.onvif.org/name/Front",
+		"onvif://www.onvif.org/Profile/Streaming",
+		"onvif://www.onvif.org/type/Network_Video_Transmitter",
+	}, scopeItems(t, GetScopesResponse(id)))
+}
+
+func TestScopeValuesAreURLEscaped(t *testing.T) {
+	name := `Hall & Co <1>/2 "Zone Ω" #3?`
+	location := "Ground floor / Unit Ü"
+	items := scopeItems(t, GetScopesResponse(Identity{Name: name, Location: location}))
+	require.Len(t, items, 4)
+	for i, prefix := range []string{"onvif://www.onvif.org/name/", "onvif://www.onvif.org/location/"} {
+		require.Regexp(t, `^`+prefix+`[A-Za-z0-9%._~!$&'()*+,;=:@-]+$`, items[i])
+		value, err := url.PathUnescape(items[i][len(prefix):])
+		require.NoError(t, err)
+		require.Equal(t, []string{name, location}[i], value)
+	}
+	// A space is %20, never a raw space, which would split the scope list
+	require.Contains(t, items[0], "Hall%20&%20Co")
+}
+
+func TestDeviceInformationIsXMLEscaped(t *testing.T) {
+	// The serial is the request's Host header: a client must not inject markup through it
+	serial := `x</tds:SerialNumber><tds:Injected>1</tds:Injected><tds:SerialNumber>y`
+	b := GetDeviceInformationResponse(`A&B "Co"`, "<Cams>", "1.9.15", serial)
+	require.NotContains(t, string(b), "<tds:Injected>")
+	info := parseDeviceInformation(t, b)
+	require.Equal(t, deviceInformation{`A&B "Co"`, "<Cams>", "1.9.15", serial}, info)
+}
