+package onvif
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/onvif"
+	"github.com/stretchr/testify/require"
+)
+
+func deviceRequest(action string) string {
+	return `<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope"><s:Body>` +
+		`<tds:` + action + ` xmlns:tds="http://www.onvif.org/ver10/device/wsdl"/></s:Body></s:Envelope>`
+}
+
+func TestDeviceServiceAnnouncesTheIdentity(t *testing.T) {
+	saved := onvif.DeviceIdentity
+	t.Cleanup(func() { onvif.DeviceIdentity = saved })
+	onvif.DeviceIdentity = onvif.Identity{Name: "Front & co", Manufacturer: "Moonie-Cams", Model: "Cams"}
+
+	w := httptest.NewRecorder()
+	r := httptest.NewRequest("POST", "/onvif/device_service", strings.NewReader(deviceRequest("GetDeviceInformation")))
+	r.Host = "192.0.2.10"
+	onvifDeviceService(w, r)
+	body := w.Body.String()
+	require.Contains(t, body, "<tds:Manufacturer>Moonie-Cams</tds:Manufacturer>")
+	require.Contains(t, body, "<tds:Model>Cams</tds:Model>")
+	// The serial stays upstream's: the address the client reached, unique per copy
+	require.Contains(t, body, "<tds:SerialNumber>192.0.2.10</tds:SerialNumber>")
+
+	w = httptest.NewRecorder()
+	onvifDeviceService(w, httptest.NewRequest("POST", "/onvif/device_service", strings.NewReader(deviceRequest("GetScopes"))))
+	body = w.Body.String()
+	require.Contains(t, body, "<tt:ScopeItem>onvif://www.onvif.org/name/Front%20&amp;%20co</tt:ScopeItem>")
+	require.NotContains(t, body, "/name/go2rtc")
+	require.NotContains(t, body, "/location/")
+}
