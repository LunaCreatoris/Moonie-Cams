@@ -0,0 +1,104 @@
+package streams
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/stretchr/testify/require"
+)
+
+type healthFake struct {
+	core.Connection
+}
+
+func (f *healthFake) Start() error { return nil }
+
+func (f *healthFake) AddTrack(*core.Media, *core.Codec, *core.Receiver) error { return nil }
+
+func TestHealthShowsCountersOnly(t *testing.T) {
+	saved := streams
+	t.Cleanup(func() { streams = saved })
+	streams = map[string]*Stream{}
+	stream := NewStream(nil)
+	streams["cam"] = stream
+
+	prod := &healthFake{core.Connection{
+		FormatName: "rtsp", Protocol: "rtsp", URL: "rtsp://user:hunter2@192.0.2.2/s1",
+		Source: "rtsp://user:hunter2@192.0.2.2/s1", RemoteAddr: "192.0.2.2:554", Recv: 1000,
+	}}
+	stream.AddProducer(prod)
+
+	cons := &healthFake{core.Connection{
+		FormatName: "mjpeg", Protocol: "http", RemoteAddr: "203.0.113.9:51000", UserAgent: "Firefox",
+		URL: "/api/stream.mjpeg?src=cam", Send: 500,
+	}}
+	sender := core.NewSender(&core.Media{Kind: core.KindVideo}, &core.Codec{Name: core.CodecJPEG})
+	sender.Drops = 3
+	cons.Senders = []*core.Sender{sender}
+	internal := &healthFake{core.Connection{FormatName: "rtsp", Protocol: "rtsp+tcp", RemoteAddr: "127.0.0.1:40000"}}
+	// The RTSP server leaves its own Send at 0; its senders count the bytes.
+	rtspSender := core.NewSender(&core.Media{Kind: core.KindVideo}, &core.Codec{Name: core.CodecH264})
+	rtspSender.Bytes, rtspSender.Packets = 7, 2
+	internal.Senders = []*core.Sender{rtspSender}
+	stream.consumers = append(stream.consumers, cons, internal)
+
+	w := httptest.NewRecorder()
+	apiHealth(w, httptest.NewRequest("GET", "/api/health", nil))
+	require.Equal(t, http.StatusOK, w.Code)
+
+	body := w.Body.String()
+	for _, leak := range []string{"hunter2", "192.0.2.2", "203.0.113.9", "127.0.0.1", "Firefox", "url", "source", "remote_addr", "src="} {
+		require.False(t, strings.Contains(body, leak), "health leaks %q: %s", leak, body)
+	}
+
+	var got map[string]healthStream
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &got))
+	require.Equal(t, []healthConn{{State: "external", FormatName: "rtsp", Protocol: "rtsp", BytesRecv: 1000}}, got["cam"].Producers)
+	require.Equal(t, []healthConn{
+		{FormatName: "mjpeg", Protocol: "http", BytesSend: 500, Drops: 3},
+		{FormatName: "rtsp", Protocol: "rtsp+tcp", BytesSend: 7, Packets: 2, Internal: true},
+	}, got["cam"].Consumers)
+}
+
+func TestHealthIsReadOnly(t *testing.T) {
+	for _, method := range []string{"POST", "PUT", "PATCH", "DELETE"} {
+		w := httptest.NewRecorder()
+		apiHealth(w, httptest.NewRequest(method, "/api/health?src=cam", nil))
+		require.Equal(t, http.StatusMethodNotAllowed, w.Code, method)
+		require.Equal(t, "GET", w.Header().Get("Allow"))
+	}
+}
+
+func TestHealthDoesNotWaitForADial(t *testing.T) {
+	saved := streams
+	t.Cleanup(func() { streams = saved })
+	stream := NewStream(nil)
+	streams = map[string]*Stream{"cam": stream}
+
+	dialing := &Producer{state: stateNone}
+	stream.producers = []*Producer{dialing}
+	// Dial holds the producer's lock for as long as the camera takes to answer
+	dialing.mu.Lock()
+	defer dialing.mu.Unlock()
+
+	done := make(chan *httptest.ResponseRecorder, 1)
+	go func() {
+		w := httptest.NewRecorder()
+		apiHealth(w, httptest.NewRequest("GET", "/api/health", nil))
+		done <- w
+	}()
+	select {
+	case w := <-done:
+		require.Equal(t, http.StatusOK, w.Code)
+		var got map[string]healthStream
+		require.NoError(t, json.Unmarshal(w.Body.Bytes(), &got))
+		require.Equal(t, []healthConn{{State: "busy"}}, got["cam"].Producers)
+	case <-time.After(2 * time.Second):
+		t.Fatal("api/health waits for a producer that is dialing")
+	}
+}
