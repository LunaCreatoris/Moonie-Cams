+++ b/internal/streams/health.go
@@ -0,0 +1,135 @@
+package streams
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+
+	"github.com/AlexxIT/go2rtc/internal/api"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+// GET api/health: the state and counters of every stream, and nothing else.
+// Unlike api/streams it never shows a url, a source or a remote address, and it is read-only,
+// so it can be allowed on a public listener.
+
+type healthStream struct {
+	Producers []healthConn `json:"producers"`
+	Consumers []healthConn `json:"consumers"`
+}
+
+type healthConn struct {
+	State      string `json:"state,omitempty"`
+	FormatName string `json:"format_name,omitempty"`
+	Protocol   string `json:"protocol,omitempty"`
+	BytesRecv  int    `json:"bytes_recv"`
+	BytesSend  int    `json:"bytes_send"`
+	Packets    int    `json:"packets"`
+	Drops      int    `json:"drops"`
+	// Internal marks a peer on loopback (go2rtc's own ffmpeg reading a stream back), so a
+	// client count can leave it out without the address being shown.
+	Internal bool `json:"internal,omitempty"`
+}
+
+// healthFields is the allow-list read back from a connection's own JSON: anything else it
+// carries (url, source, remote_addr, user_agent, sdp, medias) is dropped by the decoder.
+type healthFields struct {
+	FormatName string `json:"format_name"`
+	Protocol   string `json:"protocol"`
+	RemoteAddr string `json:"remote_addr"`
+	BytesRecv  int    `json:"bytes_recv"`
+	BytesSend  int    `json:"bytes_send"`
+	Receivers  []struct {
+		Bytes   int `json:"bytes"`
+		Packets int `json:"packets"`
+	} `json:"receivers"`
+	Senders []struct {
+		Bytes   int `json:"bytes"`
+		Packets int `json:"packets"`
+		Drops   int `json:"drops"`
+	} `json:"senders"`
+}
+
+var stateNames = map[state]string{
+	stateNone:     "idle",
+	stateMedias:   "dialed",
+	stateTracks:   "dialed",
+	stateStart:    "running",
+	stateExternal: "external",
+	stateInternal: "internal",
+}
+
+func healthOf(v any) healthConn {
+	var f healthFields
+	if b, err := json.Marshal(v); err == nil {
+		_ = json.Unmarshal(b, &f)
+	}
+	h := healthConn{FormatName: f.FormatName, Protocol: f.Protocol, BytesRecv: f.BytesRecv, BytesSend: f.BytesSend}
+	h.Internal = strings.HasPrefix(f.RemoteAddr, "127.") || strings.HasPrefix(f.RemoteAddr, "[::1]")
+	// Some connections never update their own byte counter (the RTSP server adds to it only
+	// when a write fails), so fall back to what their tracks counted.
+	var recv, send int
+	for _, r := range f.Receivers {
+		recv += r.Bytes
+		h.Packets += r.Packets
+	}
+	for _, s := range f.Senders {
+		send += s.Bytes
+		h.Packets += s.Packets
+		h.Drops += s.Drops
+	}
+	h.BytesRecv = max(h.BytesRecv, recv)
+	h.BytesSend = max(h.BytesSend, send)
+	return h
+}
+
+func (s *Stream) health() healthStream {
+	s.mu.Lock()
+	producers := append([]*Producer(nil), s.producers...)
+	consumers := append([]core.Consumer(nil), s.consumers...)
+	s.mu.Unlock()
+
+	h := healthStream{Producers: []healthConn{}, Consumers: []healthConn{}}
+	for _, prod := range producers {
+		// Dial holds the producer's lock while the camera answers: report it busy rather
+		// than wait, so the healthcheck never times out on a slow camera.
+		if !prod.mu.TryLock() {
+			h.Producers = append(h.Producers, healthConn{State: "busy"})
+			continue
+		}
+		st, conn := prod.state, prod.conn
+		prod.mu.Unlock()
+		var c healthConn
+		if conn != nil {
+			c = healthOf(conn)
+		}
+		c.State = stateNames[st]
+		h.Producers = append(h.Producers, c)
+	}
+	for _, cons := range consumers {
+		h.Consumers = append(h.Consumers, healthOf(cons))
+	}
+	return h
+}
+
+func apiHealth(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "GET" {
+		w.Header().Set("Allow", "GET")
+		http.Error(w, "", http.StatusMethodNotAllowed)
+		return
+	}
+
+	streamsMu.Lock()
+	all := make(map[string]*Stream, len(streams))
+	for name, stream := range streams {
+		all[name] = stream
+	}
+	streamsMu.Unlock()
+
+	// encoding/json writes map keys sorted, so the answer is stable.
+	info := make(map[string]healthStream, len(all))
+	for name, stream := range all {
+		info[name] = stream.health()
+	}
+	api.ResponseJSON(w, info)
+}
