+package webrtc
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/internal/api/ws"
+	"github.com/AlexxIT/go2rtc/internal/streams"
+	pion "github.com/pion/webrtc/v4"
+	"github.com/stretchr/testify/require"
+)
+
+// realPeerConnection makes PeerConnection a plain pion one for the test, as Init would.
+func realPeerConnection(t *testing.T) {
+	saved := PeerConnection
+	t.Cleanup(func() { PeerConnection = saved })
+	PeerConnection = func(bool) (*pion.PeerConnection, error) {
+		return pion.NewPeerConnection(pion.Configuration{})
+	}
+}
+
+// sendonlyOffer is what a client that wants to push video sends: one sendonly video track.
+func sendonlyOffer(t *testing.T) string {
+	pc, err := pion.NewPeerConnection(pion.Configuration{})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = pc.Close() })
+	_, err = pc.AddTransceiverFromKind(pion.RTPCodecTypeVideo, pion.RTPTransceiverInit{Direction: pion.RTPTransceiverDirectionSendonly})
+	require.NoError(t, err)
+	offer, err := pc.CreateOffer(nil)
+	require.NoError(t, err)
+	return offer.SDP
+}
+
+func TestWHEPRefusesPush(t *testing.T) {
+	cam, dials := configCam(t)
+	realPeerConnection(t)
+	offer := sendonlyOffer(t)
+
+	for _, contentType := range []string{MimeSDP, "text/plain"} {
+		r := httptest.NewRequest("POST", "/api/webrtc?src=cam", strings.NewReader(offer))
+		r.Header.Set("Content-Type", contentType)
+		w := httptest.NewRecorder()
+		syncHandler(w, r)
+		require.Equal(t, http.StatusForbidden, w.Code, contentType)
+		requireUnchanged(t, cam, dials)
+	}
+}
+
+func TestExchangeSDPRefusesPush(t *testing.T) {
+	cam, dials := configCam(t)
+	realPeerConnection(t)
+
+	_, err := ExchangeSDP(cam, sendonlyOffer(t), "webrtc/whep", "")
+	require.ErrorIs(t, err, streams.ErrPushDisabled)
+	requireUnchanged(t, cam, dials)
+}
+
+func TestWSIgnoresClientICEServers(t *testing.T) {
+	cam, dials := configCam(t)
+
+	// The offer's ice_servers must never reach a PeerConnection: only the config's are used
+	fake := errors.New("fake: config PeerConnection")
+	calls := 0
+	saved := PeerConnection
+	t.Cleanup(func() { PeerConnection = saved })
+	PeerConnection = func(bool) (*pion.PeerConnection, error) {
+		calls++
+		return nil, fake
+	}
+
+	tr := &ws.Transport{Request: httptest.NewRequest("GET", "/api/ws?src=cam", nil)}
+	err := asyncHandler(tr, &ws.Message{Type: "webrtc", Value: map[string]any{
+		"type":        "offer",
+		"sdp":         "v=0",
+		"ice_servers": []map[string]any{{"urls": []string{"turn:192.0.2.1:3478"}, "username": "u", "credential": "p"}},
+	}})
+	require.ErrorIs(t, err, fake)
+	require.Equal(t, 1, calls)
+	requireUnchanged(t, cam, dials)
+}
