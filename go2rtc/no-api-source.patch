+// configCam adds a config stream "cam" behind a fake rtsp handler that records every dial.
+func configCam(t *testing.T) (*streams.Stream, func() []string) {
+	var mu sync.Mutex
+	var dials []string
+	streams.HandleFunc("rtsp", func(source string) (core.Producer, error) {
+		mu.Lock()
+		dials = append(dials, source)
