+package streams
+
+import (
+	"errors"
+	"net/url"
+	"sync"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/stretchr/testify/require"
+)
+
+// configStreams replaces the streams with one config stream "cam" and a fake rtsp handler
+// that records every dial, and restores both after the test.
+func configStreams(t *testing.T) (*Stream, func() []string) {
+	savedStreams, savedHandler, hadHandler := streams, handlers["rtsp"], handlers["rtsp"] != nil
+	t.Cleanup(func() {
+		streams = savedStreams
+		if hadHandler {
+			handlers["rtsp"] = savedHandler
+		} else {
+			delete(handlers, "rtsp")
+		}
+	})
+
+	var mu sync.Mutex
+	var dials []string
+	HandleFunc("rtsp", func(source string) (core.Producer, error) {
+		mu.Lock()
+		dials = append(dials, source)
+		mu.Unlock()
+		return nil, errors.New("fake rtsp: no dial in tests")
+	})
+
+	cam := NewStream("rtsp://192.0.2.2/real")
+	streams = map[string]*Stream{"cam": cam}
+	return cam, func() []string {
+		mu.Lock()
+		defer mu.Unlock()
+		return append([]string(nil), dials...)
+	}
+}
+
+func TestGetOrPatchFindsConfigStream(t *testing.T) {
+	cam, _ := configStreams(t)
+
+	stream, err := GetOrPatch(url.Values{"src": {"cam"}})
+	require.NoError(t, err)
+	require.Same(t, cam, stream)
+}
+
+func TestGetOrPatchNeverCreatesOrPatches(t *testing.T) {
+	cam, dials := configStreams(t)
+
+	for _, raw := range []string{
+		"src=",
+		"src=rtsp://192.0.2.1/x",
+		"src=rtsp://192.0.2.1/x&name=cam",
+		"src=rtsp://192.0.2.1/x&name=new",
+		"src=ffmpeg:rtsp://192.0.2.1/x%23video=h264&name=cam",
+		"src=rtsp://127.0.0.1:8554/cam&name=alias",
+		"src=nope&name=cam",
+	} {
+		query, err := url.ParseQuery(raw)
+		require.NoError(t, err)
+
+		stream, err := GetOrPatch(query)
+		require.Error(t, err, raw)
+		require.Nil(t, stream, raw)
+
+		require.Equal(t, []string{"cam"}, GetAllNames(), raw)
+		require.Same(t, cam, streams["cam"], raw)
+		require.Equal(t, []string{"rtsp://192.0.2.2/real"}, cam.Sources(), raw)
+	}
+	require.Empty(t, dials())
+}
